rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
  function member(org) { return signed() && profile().org_id == org; }
  function admin(org) { return member(org) && profile().role == 'admin'; }
  function afterAdmin(org) {
   let u = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
   return signed() && u.org_id == org && u.role == 'admin';
  }
  match /users/{uid} {
   allow get: if signed() && (uid == request.auth.uid || member(resource.data.org_id));
   allow list: if member(resource.data.org_id);
   allow create: if signed() && uid == request.auth.uid
    && request.resource.data.keys().hasOnly(['id','login_id','name','org_id','role','invite_id'])
    && request.resource.data.id == uid && request.resource.data.login_id == request.auth.token.email
    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
    && ((request.resource.data.role == 'admin'
      && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.org_id)).data.owner_id == uid)
     || (request.resource.data.role == 'surveyor'
      && get(/databases/$(database)/documents/invites/$(request.resource.data.invite_id)).data.org_id == request.resource.data.org_id
      && get(/databases/$(database)/documents/invites/$(request.resource.data.invite_id)).data.expires_at > request.time.toMillis()));
  }
  match /organizations/{oid} {
   allow read: if member(oid);
   allow create: if signed() && request.resource.data.keys().hasOnly(['id','name','owner_id','created_at'])
    && request.resource.data.id == oid && request.resource.data.owner_id == request.auth.uid
    && !exists(/databases/$(database)/documents/users/$(request.auth.uid)) && afterAdmin(oid);
  }
  match /invites/{code} {
   allow get: if signed();
   allow list: if admin(resource.data.org_id);
   allow create: if admin(request.resource.data.org_id)
    && request.resource.data.keys().hasOnly(['id','code','token','org_id','label','created_at','expires_at'])
    && code.matches('[A-F0-9]{32}') && request.resource.data.id == code
    && request.resource.data.code == code && request.resource.data.token == code
    && request.resource.data.expires_at > request.time.toMillis()
    && request.resource.data.expires_at <= request.time.toMillis() + 604860000;
   allow delete: if admin(resource.data.org_id);
  }
  match /projects/{pid} {
   allow read: if member(resource.data.org_id);
   allow create: if afterAdmin(request.resource.data.org_id) && request.resource.data.id == pid
    && request.resource.data.owner_id == request.auth.uid
    && request.resource.data.keys().hasOnly(['id','org_id','owner_id','name','description','cities']);
   allow update: if admin(resource.data.org_id)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','cities']);
  }
  match /forms/{fid} {
   allow read: if member(resource.data.org_id) && (profile().role == 'admin' || resource.data.status == 'published');
   allow create: if afterAdmin(request.resource.data.org_id)
    && request.resource.data.id == fid && request.resource.data.status == 'draft'
    && getAfter(/databases/$(database)/documents/projects/$(request.resource.data.project_id)).data.org_id == request.resource.data.org_id
    && request.resource.data.keys().hasOnly(['id','org_id','project_id','lineage','version','status','title','description','questions','reviewed'])
    && request.resource.data.questions is list && request.resource.data.questions.size() <= 200;
   allow update: if admin(resource.data.org_id)
    && ((resource.data.status == 'draft'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','questions','reviewed','status'])
      && request.resource.data.status in ['draft','published']
      && request.resource.data.questions is list && request.resource.data.questions.size() <= 200
      && (request.resource.data.status == 'draft' || (request.resource.data.reviewed == true && request.resource.data.questions.size() > 0)))
     || (resource.data.status == 'published' && request.resource.data.status == 'closed'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
  }
  match /responses/{rid} {
   allow get: if signed() && (!exists(/databases/$(database)/documents/responses/$(rid)) ||
    (member(resource.data.org_id) && (profile().role == 'admin' || resource.data.collector_id == request.auth.uid)));
   allow list: if member(resource.data.org_id) && (profile().role == 'admin' || resource.data.collector_id == request.auth.uid);
   allow create: if member(request.resource.data.org_id)
    && request.resource.data.keys().hasOnly(['id','org_id','project_id','form_id','form_version','collector_id','collector_name','collected_at','received_at','timezone','review_status','signature','answers','statuses','received_server_at'])
    && request.resource.data.id == rid && request.resource.data.collector_id == request.auth.uid
    && request.resource.data.collector_name == profile().name
    && request.resource.data.review_status == 'unreviewed'
    && request.resource.data.received_server_at == request.time
    && request.resource.data.answers is map && request.resource.data.statuses is map
    && get(/databases/$(database)/documents/forms/$(request.resource.data.form_id)).data.status == 'published'
    && get(/databases/$(database)/documents/forms/$(request.resource.data.form_id)).data.org_id == request.resource.data.org_id
    && get(/databases/$(database)/documents/forms/$(request.resource.data.form_id)).data.project_id == request.resource.data.project_id
    && get(/databases/$(database)/documents/forms/$(request.resource.data.form_id)).data.version == request.resource.data.form_version;
   // Submitted records are append-only, including for administrators.
  }
 }
}
